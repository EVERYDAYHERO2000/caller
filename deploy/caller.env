# /etc/default/caller — bootstrap settings for the caller service.
# Everything else (ports, Yandex keys, auto-answer…) is configured in the web UI.
CALLER_HOST=0.0.0.0
CALLER_PORT=8080
# HTTPS for the browser handset (microphone needs HTTPS). Self-signed cert is created
# in $CALLER_DATA_DIR/tls on first start; set to 0 to disable.
CALLER_SSL_PORT=8443
CALLER_DATA_DIR=/var/lib/caller
CALLER_LOG_LEVEL=INFO
# CALLER_MOCK=1   # run without the modem (emulator)
